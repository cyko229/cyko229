# Copy to .env (next to docker-compose.yml) before `docker compose up -d`.

# The domain whose A/AAAA record points at this machine. Caddy gets the
# certificate for it automatically.
DOMAIN=remotewake.example.com

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
