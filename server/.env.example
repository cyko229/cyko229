# Copy to .env and edit before running in production.

# Port the HTTP/WebSocket server listens on.
PORT=8080

# Secret used to sign web-session JWTs. MUST be long and random in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the JSON data store is written.
DATA_FILE=./data/store.json

# Set to "true" only when serving over HTTPS (so session cookies get the Secure flag).
# In production you MUST terminate TLS in front of this server (see README).
SECURE_COOKIES=false
