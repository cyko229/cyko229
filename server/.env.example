# Copy to .env and edit before running in production.

# Port the HTTP/WebSocket server listens on.
PORT=8080

# Secret used to sign web-session JWTs. MUST be long and random in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the JSON data store is written.
DATA_FILE=./data/store.json

# Set to "true" only when serving over HTTPS (so session cookies get the Secure flag).
# In production you MUST terminate TLS in front of this server (see README).
SECURE_COOKIES=false

# --- Firebase Cloud Messaging (optional but recommended) --------------------
# FCM is the only channel that reaches a phone sleeping in Doze. Without it the
# server falls back to the WebSocket alone, which needs the battery exemption.
#
# Create a free Firebase project, then: Project settings > Service accounts >
# "Generate new private key". Either point at that JSON file:
#FCM_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
#
# ...or paste the three fields it contains (keep \n escapes in the key):
#FCM_PROJECT_ID=my-remotewake-project
#FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@my-remotewake-project.iam.gserviceaccount.com
#FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
