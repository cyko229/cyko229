{
  "name": "remotewake-server",
  "version": "1.0.0",
  "description": "Secure relay server to wake/lock an Android phone screen remotely from a web app, with FCM push delivery and a configurable keep-screen-on timer",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node test/store.test.mjs && node test/fcm.test.mjs",
    "test:e2e": "node test/e2e.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  }
}
